<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de cada item da lista de despesas no RecyclerView -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:backgroundTint="#F5F5F5">

    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <!-- Ícone de moeda -->
        <TextView
            android:text="💰"
            android:textSize="32sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"/>

        <!-- Informações da despesa -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <!-- Descrição -->
            <TextView
                android:id="@+id/tvItemDescricao"
                android:text="Descrição da despesa"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Cartão -->
            <TextView
                android:id="@+id/tvItemCartao"
                android:text="💳 Nubank"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Data -->
            <TextView
                android:id="@+id/tvItemData"
                android:text="📅 01/01/2026"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Valor -->
        <TextView
            android:id="@+id/tvItemValor"
            android:text="R$ 150,00"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1E88E5"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>